# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted on Cloud Run.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token received from @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCDefGhIJKlmNoPQRsTUVwxyZ"

# TELEGRAM_ADMIN_ID: Numerical Telegram User ID of the admin/whitelist (comma-separated for multiple IDs)
TELEGRAM_ADMIN_ID="123456789"
